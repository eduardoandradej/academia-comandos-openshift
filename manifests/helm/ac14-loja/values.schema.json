{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicaCount", "image", "pagina"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1, "maximum": 2},
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent"]}
      }
    },
    "pagina": {
      "type": "object",
      "properties": {"conteudo": {"type": "string"}}
    },
    "env": {"type": "object", "additionalProperties": {"type": "string"}},
    "route": {
      "type": "object",
      "properties": {"enabled": {"type": "boolean"}, "host": {"type": "string"}}
    },
    "resources": {"type": "object"}
  }
}
